# Copy this file to .env.local and fill in the real value.
#
# Only needed when the frontend and backend are on different hosts (e.g.
# deployed separately, or exposed through a tunnel with its own domain).
# For plain local dev with both running on localhost, this can be left
# unset entirely; it defaults to http://localhost:8000.

VITE_API_URL=https://your-backend-domain.example.com
